{
  "manifest_version": 3,
  "name": "LaptopChildren — Chặn website",
  "version": "1.0.0",
  "minimum_chrome_version": "105",
  "description": "Áp dụng chính sách website từ LaptopChildren Agent, kể cả khi trình duyệt đang mở.",
  "key": "",
  "permissions": ["nativeMessaging", "declarativeNetRequest", "tabs", "webNavigation", "alarms", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "LaptopChildren — đang kết nối Agent"},
  "incognito": "spanning"
}

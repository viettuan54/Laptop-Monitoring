{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laptopmonitor.local/schema/text_safety_record.schema.json",
  "title": "Three-label Vietnamese school-violence record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "text", "label", "split", "source_ids", "review_status", "source"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "text": {"type": "string", "minLength": 1, "maxLength": 4000},
    "label": {"enum": ["SAFE", "RISK", "HIGH_RISK"]},
    "split": {"enum": ["train", "validation", "test"]},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "review_status": {"enum": ["unreviewed", "reviewed"]},
    "source": {"type": "string", "minLength": 1}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://child-monitor.local/schemas/app-classification-record-1.0.0.json",
  "title": "Child Monitor application classification CSV record",
  "type": "object",
  "additionalProperties": false,
  "required": ["app_name", "display_name", "label"],
  "properties": {
    "app_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "display_name": {
      "type": "string",
      "maxLength": 150
    },
    "label": {
      "enum": [
        "learning",
        "entertainment",
        "browsers",
        "unknown"
      ]
    }
  }
}

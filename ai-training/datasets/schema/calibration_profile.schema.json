{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://child-monitor.local/schemas/distance-calibration-profile-1.0.0.json",
  "title": "Child Monitor eye-distance calibration profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_version",
    "distance_standard_version",
    "profile_scope",
    "camera_id",
    "subject_id",
    "frame_width",
    "frame_height",
    "calibration_scale_cm",
    "sample_count",
    "calibration_distances_cm",
    "training_mae_cm",
    "created_at"
  ],
  "properties": {
    "profile_version": {
      "const": "1.0.0"
    },
    "distance_standard_version": {
      "const": "1.0.0"
    },
    "profile_scope": {
      "const": "subject_camera"
    },
    "camera_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "subject_id": {
      "type": "string",
      "pattern": "^subject-[A-Za-z0-9_-]+$"
    },
    "frame_width": {
      "type": "integer",
      "minimum": 1
    },
    "frame_height": {
      "type": "integer",
      "minimum": 1
    },
    "calibration_scale_cm": {
      "type": "number",
      "minimum": 1,
      "maximum": 20
    },
    "sample_count": {
      "type": "integer",
      "minimum": 6
    },
    "calibration_distances_cm": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "number",
        "minimum": 20,
        "maximum": 200
      }
    },
    "training_mae_cm": {
      "type": "number",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

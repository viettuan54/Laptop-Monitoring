{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://child-monitor.local/schemas/distance-calibration-profile-3.0.0.json",
  "title": "Child Monitor monotonic eye-distance calibration profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_version",
    "distance_standard_version",
    "profile_scope",
    "model_type",
    "coefficient_order",
    "coefficients",
    "feature_range",
    "operating_distance_range_cm",
    "decision_policy",
    "source_session_ids",
    "camera_id",
    "subject_id",
    "frame_width",
    "frame_height",
    "sample_count",
    "calibration_distances_cm",
    "training_metrics",
    "legacy_single_scale",
    "created_at"
  ],
  "properties": {
    "profile_version": {
      "const": "3.0.0"
    },
    "distance_standard_version": {
      "const": "1.0.0"
    },
    "profile_scope": {
      "const": "subject_camera"
    },
    "model_type": {
      "const": "monotonic_inverse_eye_separation_linear"
    },
    "coefficient_order": {
      "const": [
        "slope",
        "intercept"
      ]
    },
    "coefficients": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slope",
        "intercept"
      ],
      "properties": {
        "slope": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "intercept": {
          "type": "number"
        }
      }
    },
    "feature_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inverse_eye_separation_min",
        "inverse_eye_separation_max"
      ],
      "properties": {
        "inverse_eye_separation_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "inverse_eye_separation_max": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "operating_distance_range_cm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum"
      ],
      "properties": {
        "minimum": {
          "type": "number",
          "minimum": 20,
          "maximum": 200
        },
        "maximum": {
          "type": "number",
          "minimum": 20,
          "maximum": 200
        }
      }
    },
    "decision_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threshold_cm",
        "warning_below_cm",
        "safe_at_or_above_cm",
        "uncertain_action"
      ],
      "properties": {
        "threshold_cm": {
          "type": "number",
          "minimum": 20,
          "maximum": 80
        },
        "warning_below_cm": {
          "type": "number",
          "minimum": 10,
          "maximum": 80
        },
        "safe_at_or_above_cm": {
          "type": "number",
          "minimum": 20,
          "maximum": 100
        },
        "uncertain_action": {
          "const": "continue_sampling"
        }
      }
    },
    "source_session_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^calibration-[A-Za-z0-9_-]+$"
      }
    },
    "camera_id": {
      "type": "string",
      "pattern": "^camera-[A-Za-z0-9_-]{1,120}$",
      "maxLength": 128
    },
    "subject_id": {
      "type": "string",
      "pattern": "^subject-[A-Za-z0-9_-]+$"
    },
    "frame_width": {
      "type": "integer",
      "minimum": 1
    },
    "frame_height": {
      "type": "integer",
      "minimum": 1
    },
    "sample_count": {
      "type": "integer",
      "minimum": 6
    },
    "calibration_distances_cm": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "number",
        "minimum": 20,
        "maximum": 200
      }
    },
    "training_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_scope",
        "mae_cm",
        "rmse_cm",
        "max_absolute_error_cm",
        "per_distance"
      ],
      "properties": {
        "evaluation_scope": {
          "const": "training_data_only"
        },
        "mae_cm": {
          "type": "number",
          "minimum": 0
        },
        "rmse_cm": {
          "type": "number",
          "minimum": 0
        },
        "max_absolute_error_cm": {
          "type": "number",
          "minimum": 0
        },
        "per_distance": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/perDistanceMetric"
          }
        }
      }
    },
    "legacy_single_scale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibration_scale_cm",
        "training_mae_cm"
      ],
      "properties": {
        "calibration_scale_cm": {
          "type": "number",
          "minimum": 1,
          "maximum": 20
        },
        "training_mae_cm": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "perDistanceMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_distance_cm",
        "sample_count",
        "predicted_mean_cm",
        "bias_cm",
        "mae_cm"
      ],
      "properties": {
        "actual_distance_cm": {
          "type": "number",
          "minimum": 20,
          "maximum": 200
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "predicted_mean_cm": {
          "type": "number"
        },
        "bias_cm": {
          "type": "number"
        },
        "mae_cm": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}

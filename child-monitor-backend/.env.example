NODE_ENV=development
PORT=3000

JWT_SECRET=replace_with_at_least_32_random_bytes

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=child_monitor_db
DB_ADMIN_USER=app_admin
DB_ADMIN_PASSWORD=change_me
DB_BACKEND_USER=app_backend
DB_BACKEND_PASSWORD=change_me

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Text safety moderation runs only on the Backend; never place this key in the Agent.
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest

# Push notification thật. Bật sau khi đã chạy migration_v13.sql.
# Có thể dùng expo, fcm hoặc cả hai (phân cách bằng dấu phẩy).
PUSH_NOTIFICATIONS_ENABLED=false
PUSH_PROVIDERS=expo,fcm

# Expo: chỉ bắt buộc khi đã bật Enhanced Push Security trong EAS.
EXPO_ACCESS_TOKEN=

# FCM: ưu tiên trỏ GOOGLE_APPLICATION_CREDENTIALS đến file service-account.
# FIREBASE_SERVICE_ACCOUNT_JSON có thể là JSON một dòng hoặc JSON đã mã hóa base64.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Bắt buộc xác thực khuôn mặt sau mật khẩu đối với role admin.
FACE_AUTH_REQUIRED_FOR_ADMIN=true
FACE_PYTHON_BIN=python
FACE_AUTH_TIMEOUT_MS=120000
FACE_AUTH_MAX_CONCURRENT=1
FACE_CLASSIFICATION_THRESHOLD=0.75
FACE_DETECTION_THRESHOLD=0.60

# Bắt buộc ở production. Dùng rediss:// khi Redis provider hỗ trợ TLS.
REDIS_URL=redis://127.0.0.1:6379

# Parent Dashboard mặc định chạy ở child-monitor-web:5173.
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173
TRUST_PROXY=loopback

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Laptop Monitor <no-reply@laptopmonitor.local>"

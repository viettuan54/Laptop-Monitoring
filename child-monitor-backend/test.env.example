# Database riêng, đã chạy Data.sql và toàn bộ migration mới nhất.
# Không dùng database development hoặc production.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_NAME=child_monitor_test
TEST_DB_ADMIN_USER=app_admin_test
TEST_DB_ADMIN_PASSWORD=change_me
TEST_DB_BACKEND_USER=app_backend_test
TEST_DB_BACKEND_PASSWORD=change_me
TEST_JWT_SECRET=replace_with_at_least_32_random_bytes
TEST_REDIS_URL=redis://127.0.0.1:6380

# Unit tests mock providers. The integration suite starts its own local provider stub.
TEXT_MODERATION_PROVIDER=local
LOCAL_MODERATION_URL=http://127.0.0.1:8100
LOCAL_MODERATION_API_KEY=local-test-secret-at-least-16
LOCAL_MODERATION_TIMEOUT_MS=15000

# Set OpenAI only when explicitly running a live OpenAI check.
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
